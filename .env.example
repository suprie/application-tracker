# Application Tracker configuration
# Copy this file to .env and adjust values.

# SQLite database path (default: ./data.db)
ATS_DB=data.db

# LLM provider: "openai", "ollama", or "deepseek"
# Use "ollama" for local Ollama — it auto-inlines JSON schemas into the prompt
# since Ollama does not support the json_schema structured output format.
# AI_PROVIDER=ollama
AI_URL=http://localhost:11434/v1
AI_MODEL=qwen3:14b
# AI_API_KEY=sk-xxx                    # global API key (optional — omit for local LLMs)

# Per-stage overrides (each falls back to the base var above)
# AI_PROVIDER_MATCH=deepseek
# AI_MODEL_MATCH=deepseek-chat
# AI_URL_MATCH=https://api.deepseek.com/v1
# AI_API_KEY_MATCH=sk-deepseek-key

# LaTeX compiler (default: pdflatex)
# LATEX_CMD=lualatex

# Profile retrieval uses BM25 (keyword-based) — zero RAM, no model required.
# Chunks are auto-generated by `parse-cv` and cached to generated/chunks.json.
